<!-- J-PDF's theme "Word", now the light Acrobat palette: Adobe's own reading-room look.

     Light chrome (#F5F5F5 / #F8F8F8) around pure-white panels and a cool gray document canvas,
     with Acrobat's action blue (#1473E6) for selection and focus and Adobe red (#FA0F00) kept
     for the brand mark only. Flat surfaces, hairline borders, no grain and no bevels: the
     interface should read like a modern Acrobat window, not like a skinned form.
     Complete: every key Light.xaml declares is declared here, because the theme at
     MergedDictionaries[0] must be whole. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="GrainOpacity">0</sys:Double>
    <sys:Double x:Key="IconShadowOpacity">0.0</sys:Double>

    <!-- Segoe UI Variable, the Windows 11 UI face, over Segoe UI for Windows 10. -->
    <FontFamily x:Key="ChromeFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="MenuFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

    <x:Null x:Key="TextStroke"/>
    <x:Null x:Key="TextStrokeSoft"/>

    <!-- Acrobat action blue and its pressed shades. -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#1473E6" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#0D66D0" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#095ABA" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#1473E6" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnPrimaryBrush"      Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#1473E6" po:Freeze="True"/>
    <SolidColorBrush x:Key="InputHoverBrush"     Color="#8A8A8A" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextFooter"          Color="#6E6E6E" po:Freeze="True"/>

    <!-- Surface tiers: light chrome, pure white panes, hairline dividers. -->
    <SolidColorBrush x:Key="BackgroundBrush"   Color="#F5F5F5" po:Freeze="True"/>
    <SolidColorBrush x:Key="SurfaceBrush"      Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="PaneBrush"         Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="TableHeaderBrush"  Color="#F4F4F4" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardBorderBrush"   Color="#E0E0E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TreeLineBrush"     Color="#EDEDED" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarnBrush"         Color="#B26A00" po:Freeze="True"/>
    <SolidColorBrush x:Key="OkBrush"           Color="#12805C" po:Freeze="True"/>
    <SolidColorBrush x:Key="PaneBorderBrush"   Color="#DFDFDF" po:Freeze="True"/>

    <!-- Acrobat body ink: near-black headings, warm-neutral secondary text. -->
    <SolidColorBrush x:Key="TextBrush"        Color="#262626" po:Freeze="True"/>
    <SolidColorBrush x:Key="MutedTextBrush"   Color="#6E6E6E" po:Freeze="True"/>
    <SolidColorBrush x:Key="ChromeTextBrush"  Color="#2C2C2C" po:Freeze="True"/>
    <SolidColorBrush x:Key="DimTextBrush"     Color="#8C8C8C" po:Freeze="True"/>

    <SolidColorBrush x:Key="RowAltBrush"         Color="#0A000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowHoverBrush"       Color="#F2F2F2" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#1473E6" po:Freeze="True"/>
    <!-- List/menu selection: a light blue wash with blue ink, the way Acrobat marks a
         selected thumbnail or menu row. Saturated blue stays for data-grid rows. -->
    <LinearGradientBrush x:Key="SelectionBg" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#EDF5FE" Offset="0"/>
        <GradientStop Color="#E1EEFC" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SelectionFg" Color="#0D66D0" po:Freeze="True"/>

    <SolidColorBrush x:Key="InputBorderBrush"  Color="#C9C9C9" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuBorderBrush"     Color="#E0E0E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuTextBrush"       Color="#2C2C2C" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuHoverBrush"      Color="#F2F2F2" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#E7F1FC" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"    Color="#BDBDBD" po:Freeze="True"/>
    <SolidColorBrush x:Key="TabEdgeBrush"        Color="#661473E6" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#1473E6" po:Freeze="True"/>

    <!-- Device-type labels: quiet categorical hues, readable on white. -->
    <SolidColorBrush x:Key="TypeRouter"     Color="#B06000" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeWindows"    Color="#1473E6" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypePrinter"    Color="#8764B8" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeSwitch"     Color="#5A5A5A" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeHypervisor" Color="#C42B1C" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeNas"        Color="#12805C" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeIot"        Color="#6A2A9C" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeServer"     Color="#B0481A" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeLinux"      Color="#7A6A10" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeDns"        Color="#1A6A8C" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeHa"         Color="#157A4F" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeMobile"     Color="#4040A8" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeCamera"     Color="#9A6800" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeSmarttv"    Color="#864A86" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeMedia"      Color="#256A9C" po:Freeze="True"/>

    <!-- Shortcut categories. -->
    <SolidColorBrush x:Key="KsCatFile"   Color="#1473E6" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatNav"    Color="#6A2A9C" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatView"   Color="#A316B5" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatSearch" Color="#0B6A0B" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatEdit"   Color="#C42B1C" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatTabs"   Color="#8A6A00" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatHelp"   Color="#12805C" po:Freeze="True"/>

    <!-- Fluent geometry: gentle 4px controls, 8px windows, soft flyouts. -->
    <CornerRadius x:Key="WindowCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="SmallCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="FlyoutCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="AccentSwatchCornerRadius">9</CornerRadius>

    <SolidColorBrush x:Key="Syn_Comment"  Color="#008000" po:Freeze="True"/>
    <SolidColorBrush x:Key="Syn_String"   Color="#A31515" po:Freeze="True"/>
    <SolidColorBrush x:Key="Syn_Number"   Color="#098658" po:Freeze="True"/>
    <SolidColorBrush x:Key="Syn_Variable" Color="#001080" po:Freeze="True"/>
    <SolidColorBrush x:Key="Syn_Type"     Color="#267F99" po:Freeze="True"/>
    <SolidColorBrush x:Key="Syn_Operator" Color="#AF00DB" po:Freeze="True"/>
    <SolidColorBrush x:Key="Syn_Keyword"  Color="#0000FF" po:Freeze="True"/>

    <!-- The title bar is a touch lighter than the ribbon, as in Acrobat. -->
    <SolidColorBrush x:Key="TitleBarBrush"    Color="#F8F8F8" po:Freeze="True"/>
    <SolidColorBrush x:Key="CaptionCloseBrush" Color="#E34850" po:Freeze="True"/>
    <SolidColorBrush x:Key="AppBorderBrush"   Color="#E0E0E0" po:Freeze="True"/>

    <SolidColorBrush x:Key="OutlineRestBrush"        Color="#8A8A8A" po:Freeze="True"/>
    <SolidColorBrush x:Key="ComboHighlightTextBrush" Color="#262626" po:Freeze="True"/>
    <SolidColorBrush x:Key="GridSelectedTextBrush"   Color="#FFFFFF" po:Freeze="True"/>
    <!-- Brand mark: Adobe red, the only warm accent in a neutral room. -->
    <SolidColorBrush x:Key="AccentLogo"              Color="#FA0F00" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"             Color="#1473E6" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent"         Color="#1473E6" po:Freeze="True"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush"       Color="#F2F2F2" po:Freeze="True"/>
    <SolidColorBrush x:Key="DialogTitleBarBrush"     Color="Transparent" po:Freeze="True"/>
    <SolidColorBrush x:Key="FooterBackgroundBrush"   Color="#F8F8F8" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuSeparatorBrush"      Color="#EDEDED" po:Freeze="True"/>
    <SolidColorBrush x:Key="FileDialogPaneBrush"     Color="#F5F5F5" po:Freeze="True"/>

    <sys:Double x:Key="PaneShadowOpacity">0.18</sys:Double>
    <sys:Double x:Key="TitleBarHeight">32</sys:Double>
    <sys:Double x:Key="BarShadowOpacity">0.10</sys:Double>
    <sys:Double x:Key="FlyoutShadowOpacity">0.18</sys:Double>
    <sys:Double x:Key="WordmarkShadowOpacity">0.0</sys:Double>
    <sys:Double x:Key="TitleWordmarkBoldSize">22.52</sys:Double>
    <sys:Double x:Key="TitleWordmarkSize">15</sys:Double>
</ResourceDictionary>
