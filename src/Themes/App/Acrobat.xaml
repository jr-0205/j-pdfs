<!-- J-PDF's own Acrobat theme values: keys the kit palette does not define. AppTheme's
     AppDerivedTokens (Services/AppTheme.cs) adds them; kit keys always keep the kit's value. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="BgRecentPanel"     Color="#191A1E" po:Freeze="True"/>
    <SolidColorBrush x:Key="AnnotationBarBrush" Color="#191A1E" po:Freeze="True"/>
    <LinearGradientBrush x:Key="TabStripFadeBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0.0"  Color="#00000000"/>
        <GradientStop Offset="0.55" Color="#1A000000"/>
        <GradientStop Offset="1.0"  Color="#70000000"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="InstallBtnBg"       Color="#4D8DDB" po:Freeze="True"/>
    <SolidColorBrush x:Key="DropBorder"         Color="#30323A" po:Freeze="True"/>
    <SolidColorBrush x:Key="SettingsOpenRowBg"  Color="#22242A" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerRed"          Color="#E8112D" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgDragHandle"       Color="#3A3D45" po:Freeze="True"/>
    <SolidColorBrush x:Key="DragLine"           Color="#26282E" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgOverlay"          Color="#B3000000" po:Freeze="True"/>
    <sys:Double x:Key="HeaderShadowOpacity">0.35</sys:Double>
    <!-- Near-black reading room; pages lift off it with a hairline and a deeper shadow. -->
    <SolidColorBrush x:Key="BgCanvas"           Color="#101114" po:Freeze="True"/>
    <SolidColorBrush x:Key="PageEdgeBrush"      Color="#2A2C33" po:Freeze="True"/>
    <sys:Double x:Key="PageShadowOpacity">0.45</sys:Double>
    <SolidColorBrush x:Key="SelectionButtonBorderBrush" Color="#4D8DDB" po:Freeze="True"/>
</ResourceDictionary>
